{
  "name": "aiterm-editor",
  "private": true,
  "description": "The file editor (CodeMirror 6 + LSP client), bundled into assets/editor/editor.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=chrome90 --outfile=../assets/editor/editor.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
